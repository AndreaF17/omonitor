pkgname=omonitor
pkgver=0.2.0
pkgrel=1
pkgdesc='Arrange Hyprland displays from an Omarchy-native interface'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'hyprland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omonitor "$pkgdir/usr/bin/omonitor"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omonitor.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omonitor.svg"
  install -Dm644 "$startdir/omonitor.desktop" "$pkgdir/usr/share/applications/omonitor.desktop"
}
